# Fly.io config for the RedBlue Arena proxy+Juice Shop bundle.
# Generated by `flyctl launch --no-deploy` — this is a template; flyctl
# will offer to overwrite it with your actual app name/region, which is
# expected. Kept here so the intended shape is documented.

app = "redblue-arena-proxy"        # flyctl will ask you to confirm/change this
primary_region = "sin"              # pick the region closest to your candidates

[build]
  dockerfile = "Dockerfile"

[env]
  PORT = "4000"
  JUICE_SHOP_TARGET = "http://localhost:3000"
  MATCH_ID_HEADER = "x-match-id"

[[services]]
  internal_port = 4000
  protocol = "tcp"

  [[services.ports]]
    port = 443
    handlers = ["tls", "http"]

  [[services.ports]]
    port = 80
    handlers = ["http"]

  [services.concurrency]
    type = "connections"
    hard_limit = 250
    soft_limit = 200

# NOTE: this single-machine Dockerfile only builds the proxy image.
# Juice Shop needs to run alongside it. Two supported approaches:
#   1. (Simplest) Deploy Juice Shop as its own separate Fly app
#      (`fly launch` against `bkimminich/juice-shop` directly) and point
#      this proxy's JUICE_SHOP_TARGET at its internal Fly hostname
#      (http://<juice-shop-app>.internal:3000) via Fly's private networking.
#   2. Use `docker-compose.yml` in this folder for local dev/testing, and
#      adapt it to a single multi-process Fly machine if you prefer one
#      always-on VM (more setup, not required for the free tier).
# Approach 1 is recommended for Fly.io's free allowance and is what the
# README's "flyctl deploy" step assumes.
